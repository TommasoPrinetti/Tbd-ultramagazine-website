{
	"version": 3,
	"routes": [
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/about/?(?:/__data.json)?$",
			"dest": "/about"
		},
		{
			"src": "^/calls/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/calls/[call]"
		},
		{
			"src": "^/issues/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/issues/[issue]"
		},
		{
			"src": "^/issues/([^/]+?)/articles/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/issues/[issue]/articles/[article]"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}